PORT=3001

# Postgres (Supabase in production; local Docker for dev -- see README.md)
DATABASE_URL=

# Redis (Upstash in production; local Docker for dev)
REDIS_URL=

# OAuth2 bearer token signing
JWT_SECRET=

# Ethereum -- set CHAIN_ID=31337 for local Anvil, otherwise omit for Sepolia
CHAIN_ID=
SEPOLIA_RPC_URL=
DEPLOYER_PRIVATE_KEY=
SUBJECT_REGISTRY_ADDRESS=
FURNISHER_REGISTRY_ADDRESS=
RECIPROCITY_LEDGER_ADDRESS=
EXPOSURE_COMMITMENTS_ADDRESS=
VERDICT_ATTESTATIONS_ADDRESS=

# World ID
WORLD_ID_APP_ID=
WORLD_ID_ACTION_ID=

# ENSv2 Enhanced Access Control (consent grants) -- see src/lib/ensEac.ts for why setting this
# alone isn't sufficient; a Hardpull subname must also be minted for the prerequisite to be met
ENS_EAC_REGISTRY_ADDRESS=

# CRE workflow -- gateway JSON-RPC + JWT auth, see src/lib/creJwt.ts
# CRE_WORKFLOW_PUBLIC_KEY_HEX is the X25519 public key furnishers seal records to; print it
# with `cd cre && go run ./cmd/keygen`.
CRE_WORKFLOW_PUBLIC_KEY_HEX=
CRE_GATEWAY_URL=
CRE_CALLER_PRIVATE_KEY=
CRE_WORKFLOW_ID=
# ...or instead of CRE_WORKFLOW_ID:
CRE_WORKFLOW_OWNER=
CRE_WORKFLOW_NAME=
CRE_WORKFLOW_TAG=

# Subgraph (mainnet manifest query URL)
SUBGRAPH_URL=

# Hedera
HEDERA_OPERATOR_ACCOUNT_ID=
HEDERA_OPERATOR_PRIVATE_KEY=
HEDERA_HCS_TOPIC_ID=
X402_FACILITATOR_URL=
