###############################################################################
### Copy to `.env` (gitignored) -- or just run `go run ./cmd/keygen`, which  ###
### generates and writes both secrets for you without printing them.        ###
### DO NOT COMMIT OR SHARE `.env`.                                          ###
###############################################################################
# Default target when --target is not passed.
CRE_TARGET=staging-settings

# Ethereum key the CRE CLI uses to sign deploy/simulate operations.
CRE_ETH_PRIVATE_KEY=

# Opens furnisher sealed boxes inside the enclave. 32-byte X25519 private key, hex, no 0x.
SECRET_WORKFLOW_X25519_PRIVATE_KEY=

# Signs verdicts for VerdictAttestations.sol. 32-byte secp256k1 private key, hex, no 0x.
SECRET_ATTESTATION_SIGNER_KEY=
