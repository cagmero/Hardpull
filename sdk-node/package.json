{
  "name": "@hardpull/sdk-node",
  "version": "0.0.0",
  "private": true,
  "description": "Typed Node.js client for the Hardpull API",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "codegen": "openapi-typescript ../api/openapi.yaml -o src/generated/openapi.d.ts",
    "build": "npm run codegen && tsc -p tsconfig.json"
  },
  "dependencies": {
    "@hardpull/types": "workspace:*",
    "openapi-fetch": "^0.17.0"
  },
  "devDependencies": {
    "typescript": "^5.6.3",
    "@types/node": "^22.7.5",
    "openapi-typescript": "^7.13.0"
  }
}
